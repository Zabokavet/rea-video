# Copy to .env and fill in at least one key. Never commit .env.

# OpenAI TTS (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Lossless master format. pcm_44100 needs a Pro plan; pcm_24000 works on every plan.
# ELEVENLABS_PCM_FORMAT=pcm_24000
# Used only if your plan refuses PCM. mp3_44100_192 needs Creator or higher.
# ELEVENLABS_MP3_FORMAT=mp3_44100_128
# Characters per request; raise it for models with bigger limits (e.g. flash v2.5).
# ELEVENLABS_CHUNK_CHARS=4500

# Where narrations and the library database are stored.
# NARRATOR_DATA_DIR=data
# How many narrations generate at the same time (others wait in a queue).
# NARRATOR_WORKERS=2
# LAME VBR quality for MP3 export, 0 (best) to 9.
# NARRATOR_MP3_QUALITY=0
